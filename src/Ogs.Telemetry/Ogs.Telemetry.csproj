<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <!-- C# 9 = Unity's compiler ceiling; library source is vendored into
         engine packages, so it must compile under C# 9 everywhere.
         This includes BodyDynamicsDeriver.cs (pose→body-dynamics
         derivation shared with the BepInEx plugins). -->
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- No Cap'n Proto runtime: frames are written by the generated schema
       writers (Schema/ogs_telemetry.writers.cs) over Wire.cs, in canonical
       OGS encoding. Decoding lives in Ogs.Telemetry.Receiving. -->
  <ItemGroup>
    <!-- spans/MemoryMarshal on netstandard2.0 (BepInEx 5 Mono plugins run on
         .NET Framework, where netstandard2.1 assemblies cannot load) -->
    <PackageReference Include="System.Memory" Version="4.5.5"
                      Condition=" '$(TargetFramework)' == 'netstandard2.0' " />
  </ItemGroup>

</Project>
